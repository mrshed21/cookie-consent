{
  "name": "@clickpunk/cookie-consent",
  "version": "2.0.0",
  "description": "GDPR-compliant cookie consent for React — supports blocking/non-blocking mode, Swedish & English, light/dark theme",
  "license": "MIT",
  "author": "Clickpunk",
  "type": "module",
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "react",
    "sweden",
    "swedish",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0"
  }
}
